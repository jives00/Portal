    "fastify": "^4",
    "mqtt": "^5.16.1",
    "onnxruntime-web": "1.31.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^2"
  }
}
