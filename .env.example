# Free key from https://unsplash.com/oauth/applications (create an app, copy the Access Key).
# Without it, Portal rotates a small built-in set of photos.
UNSPLASH_ACCESS_KEY=

# Optional. DevDash's API, read by the DevDash tab. The default, http://<NAS_HOST>:3005, is right on the NAS.
# DEVDASH_URL=
